{
  "position": "top",
  "margin": 0,
  "spacing": 0,
  "expand-center": true,
  
  "modules-left":[
    "clock", 
    "bluetooth", 
    "network"
  ],

  "modules-center":[
    "hyprland/workspaces"
  ],

  "modules-right":[
    "backlight", 
    "wireplumber",
    "battery"
  ],

  "hyprland/workspaces": {
    "format": "       "
  },

  "backlight": {
    "min-length": 9,
    "device": "intel_backlight",
    "format": "{icon} {percent}%",
    "format-icons": ["󱩎", "󱩏", "󱩐", "󱩑", "󱩒", "󱩓", "󱩔", "󱩕", "󱩖", "󰛨"],
    "tooltip": false
  },

  "wireplumber": {
    "min-length": 9,
    "on-click-right": "hyprctl dispatch exec '[float; size 960 540; move 4 32] kitty wiremix'",
    "format": "{icon} {volume}%",
    "tooltip": false,
    "format-muted": "󰝟 {volume}%",
    "format-icons": ["󰕿", "󰖀", "󰕾"]
  },

  "bluetooth": {
    "min-length": 9,
    "on-click": "hyprctl dispatch exec '[float; size 960 540; move 4 32] kitty bluetui'",
    "format-on": "󰂯 󰔡",
    "format-off": "󰂲 󰨙",
    "format-disabled": "󰂲 󰨙",
    "format-connected": "󰂱 󰄬",
    "format-connected-battery": "󰂱 {device_battery_percentage}%"
  },

  "network": {
    "min-length": 9,
    "on-click": "hyprctl dispatch exec '[float; size 900 720; move 4 32] kitty gazelle'",
    "format": "{icon} {signalStrength}%",
    "tooltip-format": "{essid}",
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "interval": 5
  },

  "clock": {
    "min-length": 9,
    "timezone": "Asia/Manila",
    "locale": "en_PH.UTF-8",
    "format": "󱑂 {:%I:%M}",
    "format-alt": "󰃶 {:%m-%d}",
    "tooltip": false,
    "on-click": "toggle-format",
    "interval": 60
  },

  "battery": {
    "min-length": 9,
    "interval": 60,
    "tooltip": false,
    "format": "{icon} {capacity}%",
    "format-time": "{H}h {M}m",
    "format-alt": "{icon} {time}",
    "format-icons": {
      "default": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
      "charging": ["󰢟", "󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂊", "󰂅"]
    },
    "on-click": "toggle-format"
  }
}

