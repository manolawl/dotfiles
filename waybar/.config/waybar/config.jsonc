{
  "position": "top",
  "margin-top": 4,
  "margin-bottom": 0,
  "margin-left": 4,
  "margin-right": 4,
  "spacing": 4,
  
  "modules-left":[
    "clock", 
    "bluetooth", 
    "network",
    "backlight", 
    "wireplumber"
  ],

  "modules-center":[
    "mpris"
  ],

  "modules-right":[
    "privacy",
    "temperature", 
    "memory",
    "cpu",
    "custom/notifications"
  ],

  "user": {
    "format": "{work_H}h {work_M}m"
  },

  "hyprland/workspaces": {
    "format": "{icon}"
  },

  "hyprland/window": {
    "format": "{title}"
  },

  "mpris": {
    "min-length": 12,
	  "format": "󰝚 {title} by {artist} 󰝚"
  },

  "custom/notifications": {
    "min-length": 12,
    "tooltip": true,
    "format": "{icon} {0}",

    "format-icons": {
      "notification": "󰂚",
      "none": "󰂜",
      "dnd-notification": "󰂠",
      "dnd-none": "󰪓",
      "inhibited-notification": "󰂛",
      "inhibited-none": "󰪑",
      "dnd-inhibited-notification": "󰂛",
      "dnd-inhibited-none": "󰪑"
    },

    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },

  "backlight": {
    "min-length": 12,
    "device": "intel_backlight",
    "format": "{icon} {percent}%",
    "format-icons": ["󱩎", "󱩏", "󱩐", "󱩑", "󱩒", "󱩓", "󱩔", "󱩕", "󱩖", "󰛨"],
    "tooltip": false
  },

  "wireplumber": {
    "min-length": 12,
    "on-click-right": "hyprctl dispatch exec '[float; size 960 540; move 4 32] kitty wiremix'",
    "format": "{icon} {volume}%",
    "tooltip": false,
    "format-muted": "󰝟 {volume}%",
    "format-icons": ["󰕿", "󰖀", "󰕾"]
  },

  "bluetooth": {
    "min-length": 12,
    "on-click": "hyprctl dispatch exec '[float; size 960 540; move 4 32] kitty bluetui'",
    "format-on": "󰂯 ON",
    "format-off": "󰂲 OFF",
    "format-disabled": "󰂲 DIS",
    "format-connected": "󰂱 CON",
    "format-connected-battery": "󰂱 {device_battery_percentage}"
  },

  "network": {
    "min-length": 12,
    "on-click-right": "hyprctl dispatch exec '[float; size 1200 720; move 4 32] kitty gazelle'",
    "on-click": "toggle-format",
    "format-wifi": "{icon} {signalStrength}%",
    "format-alt": "{icon} {bandwidthTotalBytes}",
    "tooltip-format": "{essid}",
    "format-icons": ["󰤯","󰤟","󰤢","󰤥","󰤨"],
    "interval": 30
  },

  "clock": {
    "min-length": 12,
    "timezone": "Asia/Manila",
    "locale": "en_PH.UTF-8",
    "format": "󱑂 {:%I:%M}",
    "format-alt": "󰃭 {:%m-%d}",
    "tooltip": false,
    "on-click": "toggle-format",
    "interval": 60
  },

  "temperature": {
    "min-length": 12,
    "interval": 30,
    "tooltip": false,
    "format": "{icon} {temperatureC}°C",
    "format-icons": ["󱃃", "󰔏", "󱃂"]
  },

  "cpu": {
    "min-length": 12,
    "interval": 30,
    "tooltip": false,
    "format": "󰙅 {usage}%"
  },

  "memory": {
    "min-length": 12,
    "interval": 30,
    "tooltip": false,
    "format": "󰍛 {percentage}%",
    "format-alt": "󰍛 {used}G",
    "on-click": "toggle-format"
  }
}

