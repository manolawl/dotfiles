{
  "position": "top",
  "margin": 0,
  
  "modules-left":["hyprland/workspaces"],

  "modules-center":[
    "backlight", 
    "wireplumber", 
    "clock", 
    "custom/notifications", 
    "clock#date", 
    "bluetooth", 
    "network"
  ],

  "modules-right":[
    "temperature", 
    "network#rate", 
    "memory"
  ],

  "hyprland/workspaces": {
    "format": "<span font='16'>{icon}</span>",
    "format-icons": {
      "default":  "",
      "active": ""
    },
    "persistent-workspaces": {
      "eDP-1": [1, 2, 3, 4],
      "HDMI-A-1": [5, 6, 7, 8]
    }
  },

  "custom/notifications": {
    "tooltip": true,
    "format": "<span font='16'>{icon}</span>",
    "format-icons": {
      "notification": "󱅫",
      "none": "󰂜",
      "dnd-notification": "󰂠",
      "dnd-none": "󰪓",
      "inhibited-notification": "󰂛",
      "inhibited-none": "󰪑",
      "dnd-inhibited-notification": "󰂛",
      "dnd-inhibited-none": "󰪑"
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },

  "backlight": {
    "device": "intel_backlight",
    "format": "<span font='16'>{icon}</span>",
    "format-icons": ["󰃚", "󰃛", "󰃜", "󰃝", "󰃞", "󰃟", "󰃠"],
    "tooltip-format": "{percent}%"
  },

  "wireplumber": {
    "format": "<span font='16'>{icon}</span>",
    "tooltip-format": "{volume}%",
    "format-muted": "<span font='16' rise='-2000'>󰖁</span>",
    "format-icons": ["󰕿", "󰖀", "󰕾"]
  },

  "bluetooth": {
    "format-on": "<span font='16'></span>",
    "format-disabled": "<span font='16'>󰂲</span>",
    "format-connected": "<span font='16'>󰂱</span>",
    "on-click": "exec blueman-manager",
    "tooltip-format": "{controller_alias}\t{controller_address}",
	  "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
	  "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}"
  },

  "network": {
    "format-wifi": "<span font='16'>{icon}</span>",
    "tooltip-format": "{essid}",
    "on-click": "exec kitty nmtui",
    "format-icons": ["󰤯","󰤟","󰤢","󰤥","󰤨"],
    "interval": 10
  },
  
  "network#rate": {
    "format": "{bandwidthTotalBytes}",
    "min-length": 8,
    "interval": 1
  },

  "clock": {
    "timezone": "Asia/Manila",
    "locale": "en_US.UTF-8",
    "format": "{:%I:%M}",
    "tooltip": false,
    "interval": 60
  },

  "clock#date": {
    "format": "{:%m-%d}"
  },
  
  "temperature": {
    "interval": 1,
    "tooltip": false,
    "format": "{temperatureC}°"
  },

  "cpu": {
    "interval": 1,
    "min-length": 3,
    "tooltip": false,
    "format": "{usage}%"
  },

  "memory": {
    "interval": 1,
    "min-length": 7,
    "tooltip": false,
    "format": "{used}GiB"
  }
}

