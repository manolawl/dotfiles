{
  "output": "eDP-1",
  "position": "top",
  "margin-top": 8,
  "margin-right": 8,
  "margin-bottom": 0,
  "margin-left": 8,
  "spacing": 0,
  "expand-center": true,
  "fixed-center": true,
  
  "modules-left":[
    "custom/exit",
    "custom/reboot",
    "custom/poweroff"
  ],

  "modules-center":[
    "clock", 
    "bluetooth", 
    "network",
    "backlight", 
    "wireplumber",
    "privacy",
    "temperature", 
    "memory",
    "cpu",
    "disk",
    "battery",
    "power-profiles-daemon",
    "custom/notifications"
  ],

  "modules-right":[
  ],

  "custom/exit": {
    "min-length": 3,
    "tooltip": false,
    "format": "󰍃",
    "on-click": "hyprctl dispatch exit"
  },

  "custom/reboot": {
    "min-length": 3,
    "tooltip": false,
    "format": "󰜉",
    "on-click": "systemctl reboot"
  },

  "custom/poweroff": {
    "min-length": 3,
    "tooltip": false,
    "format": "󰐥",
    "on-click": "systemctl poweroff"
  },

  "user": {
    "format": "{work_H}h {work_M}m"
  },

  "hyprland/workspaces": {
    "format": "  "
  },

  "hyprland/window": {
    "format": "{title}"
  },

  "mpris": {
    "min-length": 9,
    "format": "󰝚 {title} by {artist} 󰝚"
  },

  "clock": {
    "min-length": 9,
    "timezone": "Asia/Manila",
    "locale": "en_PH.UTF-8",
    "format": "󱑂 {:%I:%M}",
    "format-alt": "󰃶 {:%m-%d}",
    "tooltip": false,
    "on-click": "toggle-format",
    "interval": 60
  },

  "bluetooth": {
    "min-length": 9,
    "on-click": "hyprctl dispatch exec '[float; size 1080 540; move 420 50] kitty bluetui'",
    "format-on": "󰂯 [#]",
    "format-off": "󰂲 [-]",
    "format-disabled": "󰂲 [ ]",
    "format-connected": "󰂱 [*]"
  },

  "network": {
    "min-length": 9,
    "on-click": "hyprctl dispatch exec '[float; size 1080 540; move 420 50] kitty gazelle'",
    "format-wifi": "{icon} [*]",
    "format-disabled": "{icon} [ ]",
    "format-disconnected": "{icon} [#]",
    "tooltip-format": "{essid}",
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "interval": 5
  },

  "backlight": {
    "min-length": 9,
    "device": "intel_backlight",
    "format": "{icon} {percent}%",
    "format-icons": ["󱩎", "󱩏", "󱩐", "󱩑", "󱩒", "󱩓", "󱩔", "󱩕", "󱩖", "󰛨"],
    "tooltip": false
  },

  "wireplumber": {
    "min-length": 9,
    "on-click": "hyprctl dispatch exec '[float; size 1080 540; move 420 50] kitty wiremix -v output'",
    "format": "{icon} {volume}%",
    "tooltip": false,
    "format-muted": "󰝟 {volume}%",
    "format-icons": ["󰕿", "󰖀", "󰕾"]
  },

  "temperature": {
    "min-length": 9,
    "interval": 5,
    "tooltip": false,
    "format": "{icon} {temperatureC}°C",
    "on-click": "hyprctl dispatch exec '[float; size 1080 540; move 420 50] kitty btop'",
    "warning-threshold": 60,
    "critical-threshold": 80,
    "format-icons": ["󱃃", "󰔏", "󱃂"]
  },

  "memory": {
    "min-length": 9,
    "interval": 5,
    "on-click": "hyprctl dispatch exec '[float; size 1080 540; move 420 50] kitty btop'",
    "tooltip": "{used}GiB",
    "format": "󰓌 {percentage}%"
  },

  "cpu": {
    "min-length": 9,
    "interval": 5,
    "tooltip": false,
    "on-click": "hyprctl dispatch exec '[float; size 1080 540; move 420 50] kitty btop'",
    "format": "󰍛 {usage}%"
  },

  "disk": {
    "min-length": 9,
    "on-click": "hyprctl dispatch exec '[float; size 1080 540; move 420 50] kitty ncdu'",
    "interval": 60,
    "format": "󰋊 {percentage_used}%"
  },

  "battery": {
    "min-length": 9,
    "interval": 60,
    "tooltip": false,
    "format": "{icon} {capacity}%",
    "format-time": "{H}h {M}m",
    "states": {
      "high": 100,
      "midhigh": 80,
      "mid": 60,
      "midlow": 40,
      "low": 20
    },

    "format-icons": {
      "default": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
      "charging": ["󰢟", "󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂊", "󰂅"]
    }
  },

  "power-profiles-daemon": {
    "min-length": 9,
    "format": "{icon}",
    "tooltip": false,
    "format-icons": {
      "default": "󱐌",
      "performance": "󱐋 [+]",
      "balanced": "󰗑 [=]",
      "power-saver": "󰌪 [-]"
    }
  },

  "custom/notifications": {
    "min-length": 9,
    "tooltip": false,
    "format": "{icon} {0}",

    "format-icons": {
      "notification": "󰂚",
      "none": "󰂜",
      "dnd-notification": "󰂠",
      "dnd-none": "󰪓",
      "inhibited-notification": "󰂛",
      "inhibited-none": "󰪑",
      "dnd-inhibited-notification": "󰂛",
      "dnd-inhibited-none": "󰪑"
    },

    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  }
}

