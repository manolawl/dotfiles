{
	"output": "eDP-1",
	"layer": "top",
	"position": "top",
	"spacing": 0,
	"expand-center": true,
	"fixed-center": true,
	"reload_on_style_change": true,

	"include": "~/.config/waybar/modules.json",

	"modules-left":[
		"hyprland/workspaces",
		"temperature",
		"memory",
		"cpu",
	],

	"modules-center":[
		"idle_inhibitor",
		"clock",
		"custom/notifications",
		"clock#date",
		"power-profiles-daemon",
	],

	"modules-right":[
		"network",
		"bluetooth",
		"wireplumber",
		"backlight",
		"battery",
	]
}

