{
	// ==> GROUPS
	"group/pmenu":{
		"modules": [
			"custom/exit",
			"custom/reboot",
			"custom/poweroff"
		]
	},

	"group/hardware":{
		"modules": [
			"disk",
			"temperature",
			"memory",
			"cpu",
		]
	},

	// ==> CUSTOM MODULES
	"custom/power": {
		"format" : "[ 󰐥 ]",
		"tooltip": false,
		"menu": "on-click",
		"menu-file": "~/.config/waybar/power_menu.xml",
		"menu-actions": {
			"shutdown": "shutdown now",
			"reboot": "reboot",
			"suspend": "systemctl suspend",
			"hibernate": "systemctl hibernate",
			"exit": "hyprctl dispatch exit",
		},
	},

	"custom/sep": {
		"format": " | "
	},

	"custom/exit": {
		"on-click": "hyprctl dispatch exit",
		"tooltip": false,
		"format": "[ 󰍃 ]",
	},

	"custom/reboot": {
		"on-click": "systemctl reboot",
		"tooltip": false,
		"format": "[ 󰜉 ]",
	},

	"custom/poweroff": {
		"on-click": "systemctl poweroff",
		"tooltip": false,
		"format": "[ 󰤂 ]",
	},

	"custom/notifications": {
		"tooltip-format": "{0}",
		"format": "{icon}",
		"format-icons": {
			"notification": "󰂚",
			"none": "󰂜",
			"dnd-notification": "󰂠",
			"dnd-none": "󰪓",
			"inhibited-notification": "󰂛",
			"inhibited-none": "󰪑",
			"dnd-inhibited-notification": "󰂛",
			"dnd-inhibited-none": "󰪑"
		},

		"return-type": "json",
		"exec-if": "which swaync-client",
		"exec": "swaync-client -swb",
		"on-click": "swaync-client -t -sw",
		"on-click-right": "swaync-client -d -sw",
		"escape": true
	},

	// ==> NATIVE MODULES
	"user": {
		"format": "{work_H}h {work_M}m"
	},

	"idle_inhibitor": {
		"tooltip": false,
		"format": "{icon}",
		"format-icons": {
			"activated": "󰈈",
			"deactivated": "󰛐",
		},
	},

	"hyprland/workspaces": {
		"active-only": true,
		"format": " {name}",
	},

	"hyprland/window": {
		"format": "{class}"
	},

	"mpris": {
		"format": "󰝚 {title} by {artist} 󰝚"
	},

	"clock": {
		"on-click": "pkill calcurse || kitty calcurse",
		"timezone": "Asia/Manila",
		"locale": "en_PH.UTF-8",
		"tooltip": false,
		"interval": 60,
		"format": "{:%I:%M}",
	},

	"clock#date": {
		"on-click": "pkill calcurse || kitty calcurse",
		"timezone": "Asia/Manila",
		"locale": "en_PH.UTF-8",
		"tooltip": false,
		"format": "{:%m-%d}",
	},

	"bluetooth": {
		"on-click": "pkill bluetui || kitty bluetui",
		"tooltip": true,
		"tooltip-format": "{device_enumerate}",
		"tooltip-format-enumerate-connected": "{device_alias}",
		"format": "{icon}",
		"format-icons": {
			"on": "󰂯",
			"connected": "󰂱",
			"off": "󰂲",
			"disabled": "󰂲"
		},
	},

	"network": {
		"on-click": "pkill impala || kitty impala",
		"interval": 1,
		"tooltip-format": "iplocal: {ipaddr}\nnetwork: {essid}\nul-rate: {bandwidthUpBytes}\ndl-rate: {bandwidthDownBytes}",
		"format": "{icon}",
		"format-icons": {
			"wifi": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
			"ethernet": "󰈀",
			"disconnected": "󰤮",
			"disabled": "󰤮"
		},
	},

	"backlight": {
		"device": "intel_backlight",
		"on-scroll-up": "brightnessctl set 25%+ && dcutil setvcp 10 + 25 --noverify --sleep-multiplier=0.2",
		"on-scroll-down": "brightnessctl set 25%- && dcutil setvcp 10 - 25 --noverify --sleep-multiplier=0.2",
		"tooltip": false,
		"states": {
			"p1": 0,
			"p2": 21,
			"p3": 41,
			"p4": 61,
			"p5": 81,
		},
		"tooltip-format": "{percent}%",
		"format": "{icon} {percent}%",
		"format-icons": ["󱩎", "󱩏", "󱩐", "󱩑", "󱩒", "󱩓", "󱩔", "󱩕", "󱩖", "󰛨"],
	},

	"wireplumber": {
		"on-click": "pkill wiremix || kitty wiremix -v output",
		"tooltip": false,
		"tooltip-format": "{volume}%",
		"states": {
			"p1": 0,
			"p2": 21,
			"p3": 41,
			"p4": 61,
			"p5": 81,
		},
		"format": "{icon} {volume}%",
		"format-muted": "󰝟 {volume}%",
		"format-icons": ["󰕿", "󰖀", "󰕾"]
	},

	"temperature": {
		"on-click": "pkill btop || kitty btop",
		"tooltip": false,
		"interval": 1,
		"format": "{icon} {temperatureC}°",
		"format-icons": ["󱃃", "󰔏", "󱃂"]
	},

	"memory": {
		"on-click": "pkill btop || kitty btop",
		"interval": 1,
		"tooltip": true,
		"tooltip-format": "format: GiB\ntotal : {total}\nunused: {avail}\nused  : {used}",
		"format": "󰓌 {percentage}%"
	},

	"cpu": {
		"on-click": "pkill btop || kitty btop",
		"interval": 1,
		"tooltip": false,
		"format": "󰍛 {usage}%"
	},

	"disk": {
		"on-click": "pkill ncdu || kitty ncdu",
		"interval": 1,
		"format": "󰋊 {percentage_used}%"
	},

	"battery": {
		"tooltip": true,
		"tooltip-format": "{time}",
		"states": {
			"p1": 20,
			"p2": 40,
			"p3": 60,
			"p4": 80,
			"p5": 100,
		},
		"format": "{icon} {capacity}%",
		"format-time": "{H}h {M}m",
		"format-icons": {
			"default": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
			"charging": ["󰢟", "󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂊", "󰂅"]
		}
	},

	"power-profiles-daemon": {
		"tooltip": false,
		"format": "{icon}",
		"format-icons": {
			"default": "󱐌",
			"performance": "󱐋",
			"balanced": "󰗑",
			"power-saver": "󰌪"
		}
	},
}
