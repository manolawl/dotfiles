{
	"hyprland/workspaces": {
		"active-only":     true,
		"format":         "󰨇 {name}",
		"on-scroll-up":   "hyprctl dispatch 'hl.dsp.focus({workspace=\"+1\"})'",
		"on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({workspace=\"-1\"})'"
	},

	"clock": {
		"timezone":       "Asia/Manila",
		"locale":         "en_PH.UTF-8",
		"tooltip":         true,
		"interval":        60,
		"format":         "{:%I:%M %a %d}",
		"tooltip-format": "{calendar}",
		"calendar":{
			"mode":        "year",
			"mode-mon-col": 4,
			"format": {
				"today":    "<span color='#71b0ff'><b><u>{}</u></b></span>",
				"days":     "<span color='#26587d'>{}</span>",
				"weekdays": "<span color='#4b90f9'><i>{}</i></span>",
				"months":   "<span color='#4b90f9'><b>{}</b></span>"
			},
		},
		
		"actions": {
			"on-click": "mode"
		}
	},

	"bluetooth": {
		"tooltip": true,
		"tooltip-format": "{device_enumerate}",
		"tooltip-format-enumerate-connected": "{device_alias}",
		"tooltip-format-enumerate-connected-battery": "{device_alias} {device_battery_percentage}%",
		"format": "{icon}",
		"format-icons": {
			"on": "󰂯",
			"connected": "󰂱",
			"off": "󰂲",
			"disabled": "󰂲"
		},
	},

	"network": {
		"interval": 15,
		"tooltip-format": "network: {essid}\niplocal: {ipaddr}\nquality: {signalStrengthApp}",
		"format": "{icon}",
		"format-icons": {
			"wifi": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
			"ethernet": "󰈁",
			"disconnected": "󰤮",
			"disabled": "󰤬"
		},
	},

	"backlight": {
		"device": "intel_backlight",
		"on-scroll-down": "brightnessctl set 1%+",
		"on-scroll-up": "brightnessctl set 1%-",
		"on-click": "pkill hyprsunset || hyprsunset",
		"tooltip": false,
		"tooltip-format": "{percent}%",
		"format": "{icon}",
		"format-icons": ["󱩎", "󱩏", "󱩐", "󱩑", "󱩒", "󱩓", "󱩔", "󱩕", "󱩖", "󰛨"],
	},

	"wireplumber": {
		"on-scroll-down": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 1%+",
		"on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 1%-",
		"tooltip": false,
		"format": "{icon}",
		"format-muted": "󰝟 {volume}",
		"format-icons": ["󰝦", "󰪞", "󰪟", "󰪠", "󰪡", "󰪢", "󰪣", "󰪤", "󰪥"]
	},

	"battery": {
		"tooltip": true,
		"states": {
			"lvl1": 20,
			"lvl2": 40,
			"lvl3": 60,
			"lvl4": 80,
			"lvl5": 100,
		},
		"format":         "{icon}",
		"tooltip-format": "{capacity}%",
		"format-icons": {
			"default":  ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
			"charging": ["󰢟", "󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂊", "󰂅"]
		}
	},

	"power-profiles-daemon": {
		"tooltip": false,
		"format": "{icon}",
		"format-icons": {
			"default": "󱐌",
			"performance": "󰓅",
			"balanced": "󰾅",
			"power-saver": "󰾆"
		}
	},

	"memory": {
		"interval": 15,
		"format": "󰍛 {percentage}%",
	},

	"temperature": {
		"tooltip": false,
		"interval": 15,
		"warning-threshold": 59,
		"critical-threshold": 79,
		"format": "󱃃 {temperatureC}°C",
		"format-warning": "󰔏 {temperatureC}°C",
		"format-critical": "󱃂 {temperatureC}°C",
	}
}
