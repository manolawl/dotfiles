{
	"hyprland/workspaces": {
		"active-only": true,
		"format": " {name}",
		"on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({workspace=\"+1\"})'",
		"on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({workspace=\"-1\"})'"
	},

	"clock": {
		"timezone": "Asia/Manila",
		"locale": "en_PH.UTF-8",
		"tooltip": true,
		"interval": 60,
		"format": "{:%I:%M %a %d}",
		"tooltip-format": "{calendar}",
		"calendar":{
			"mode": "year",
			"mode-mon-col": 4,
			"format": {
				"today": "<span color='#71b0ff'><b><u>{}</u></b></span>",
				"days": "<span color='#26587d'>{}</span>",
				"weekdays": "<span color='#4b90f9'><i>{}</i></span>",
				"months": "<span color='#4b90f9'><b>{}</b></span>"
			},
		},
		
		"actions": {
			"on-click": "mode"
		}
	},

	"bluetooth": {
		"tooltip": true,
		"tooltip-format": "{device_enumerate}",
		"tooltip-format-enumerate-connected": "{device_alias} {device_battery_percentage}%",
		"format": "{icon}",
		"format-icons": {
			"on": "󰂯",
			"connected": "󰂱",
			"off": "󰂲",
			"disabled": "󰂲"
		},
	},

	"network": {
		"tooltip-format": "network: {essid}\niplocal: {ipaddr}\nquality: {signalStrengthApp}",
		"format": "{icon}",
		"format-icons": {
			"wifi": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
			"ethernet": "󰈀",
			"disconnected": "󰤮",
			"disabled": "󰤮"
		},
	},

	"backlight": {
		"min-length": 7,
		"device": "intel_backlight",
		"on-scroll-down": "brightnessctl set 1%+",
		"on-scroll-up": "brightnessctl set 1%-",
		"on-click": "pkill hyprsunset || hyprsunset",
		"tooltip": false,
		"format": "{icon} {percent}%",
		"format-icons": ["󱩎", "󱩏", "󱩐", "󱩑", "󱩒", "󱩓", "󱩔", "󱩕", "󱩖", "󰛨"],
	},

	"wireplumber": {
		"min-length": 7,
		"on-scroll-down": "wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 1%+",
		"on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 1%-",
		"tooltip": false,
		"format": "{icon} {volume}%",
		"format-muted": "󰝟 {volume}%",
		"format-icons": ["󰕿", "󰖀", "󰕾"]
	},

	"battery": {
		"min-length": 7,
		"tooltip": false,
		"states": {
			"p1": 20,
			"p2": 40,
			"p3": 60,
			"p4": 80,
			"p5": 100,
		},
		"format":      "{icon} {capacity}%",
		"format-time": "{H}h {M}m",
		"format-icons": {
			"default":  ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
			"charging": ["󰢟", "󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂊", "󰂅"]
		}
	},

	"power-profiles-daemon": {
		"tooltip": true,
		"format": "{icon}",
		"tooltip-format": "power usage",
		"format-icons": {
			"default": "󱐌",
			"performance": "󰓅 MAX",
			"balanced": "󰾅 MID",
			"power-saver": "󰾆 LOW"
		}
	},

	"memory": {
		"interval": 5,
		"format": "󰍛 {percentage}%",
	},

	"cpu": {
		"interval": 5,
		"format": "󰘚 {usage}%",
	},

	"temperature": {
		"tooltip": false,
		"interval": 5,
		"warning-threshold": 59,
		"critical-threshold": 79,
		"format": "󱃃 {temperatureC}°C",
		"format-warning": "󰔏 {temperatureC}°C",
		"format-critical": "󱃂 {temperatureC}°C",
	}
}
