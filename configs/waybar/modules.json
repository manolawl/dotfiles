{
	"user": {
		"format": "{work_H}h {work_M}m"
	},

	"idle_inhibitor": {
		"tooltip": false,
		"format": "{icon}",
		"format-icons": {
			"activated": "󰈈",
			"deactivated": "󰛐",
		},
	},

	"hyprland/workspaces": {
		"active-only": true,
		"format": " {name}",
		"on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({workspace=\"+1\"})'",
		"on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({workspace=\"-1\"})'"
	},

	"hyprland/window": {
		"format": "{title}"
	},

	"mpris": {
		"format": "󰝚 {title} by {artist} 󰝚"
	},

	"clock": {
		"timezone": "Asia/Manila",
		"locale": "en_PH.UTF-8",
		"tooltip": true,
		"interval": 60,
		"format": "{:%I:%M %a %d}",
		"tooltip-format": "{calendar}",
		"calendar":{
			"mode": "year",
			"mode-mon-col": 4,
			"format": {
				"today": "<span color='#71b0ff'><b><u>{}</u></b></span>",
				"days": "<span color='#26587d'>{}</span>",
				"weekdays": "<span color='#4b90f9'><i>{}</i></span>",
				"months": "<span color='#4b90f9'><b>{}</b></span>"
			},
		},
		
		"actions": {
			"on-click": "mode"
		}
	},

	"bluetooth": {
		"tooltip": true,
		"tooltip-format": "{device_enumerate}",
		"tooltip-format-enumerate-connected": "{device_alias}",
		"format": "{icon}",
		"format-icons": {
			"on": "󰂯",
			"connected": "󰂱",
			"off": "󰂲",
			"disabled": "󰂲"
		},
	},

	"network": {
		"tooltip-format": "network: {essid}\niplocal: {ipaddr}\nquality: {signalStrengthApp}",
		"format": "{icon}",
		"format-icons": {
			"wifi": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
			"ethernet": "󰈀",
			"disconnected": "󰤮",
			"disabled": "󰤮"
		},
	},

	"backlight": {
		"device": "intel_backlight",
		"on-scroll-up": "brightnessctl set 10%+ && dcutil setvcp 10 + 10 --noverify --sleep-multiplier=0.2",
		"on-scroll-down": "brightnessctl set 10%- && dcutil setvcp 10 - 10 --noverify --sleep-multiplier=0.2",
		"on-click": "pkill hyprsunset || hyprsunset",
		"tooltip": false,
		"format": "{percent} {icon}",
		"format-icons": ["󱩎", "󱩏", "󱩐", "󱩑", "󱩒", "󱩓", "󱩔", "󱩕", "󱩖", "󰛨"],
	},

	"wireplumber": {
		"on-scroll-up": "wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 1%+",
		"on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 1%-",
		"tooltip": false,
		"format": "{volume} {icon}",
		"format-muted": "{volume} 󰝟",
		"format-icons": ["󰕿", "󰖀", "󰕾"]
	},

	"temperature": {
		"on-click": "pkill btop || kitty btop",
		"tooltip": false,
		"interval": 1,
		"format": "{icon} {temperatureC}°",
		"format-icons": ["󱃃", "󰔏", "󱃂"]
	},

	"memory": {
		"on-click": "pkill btop || kitty btop",
		"interval": 1,
		"tooltip": true,
		"tooltip-format": "format: GiB\ntotal : {total}\nunused: {avail}\nused  : {used}",
		"format": "󰓌 {percentage}%"
	},

	"cpu": {
		"on-click": "pkill btop || kitty btop",
		"interval": 1,
		"tooltip": false,
		"format": "󰍛 {usage}%"
	},

	"disk": {
		"on-click": "pkill ncdu || kitty ncdu",
		"interval": 1,
		"format": "󰋊 {percentage_used}%"
	},

	"battery": {
		"tooltip": false,
		"states": {
			"p1": 20,
			"p2": 40,
			"p3": 60,
			"p4": 80,
			"p5": 100,
		},
		"format":      "{capacity} {icon}",
		"format-time": "{H}h {M}m",
		"format-icons": {
			"default":  ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
			"charging": ["󰢟", "󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂊", "󰂅"]
		}
	},

	"power-profiles-daemon": {
		"tooltip": false,
		"format": "{icon}",
		"format-icons": {
			"default": "󱐌",
			"performance": "󰓅",
			"balanced": "󰾅",
			"power-saver": "󰾆"
		}
	},
}
