* {
	bg0: #26203aa6;

	fg0: #e2dff9;
	fg1: #ff60ae;
	fg2: #4b4074;

	accent: #4b407459;

	background-color: transparent;
	text-color: @fg0;

	margin: 0;
	padding: 0;
	spacing: 0;
}

window {
	location: north;
	y-offset: 8px;
	width: 25%;
	height: 25%;
	border-radius: 8;
	border-color: @fg0;
	border: 1;
	background-color: @bg0;
}

mainbox {
	children: [ inputbar, listview ];
}

inputbar {
	children: [ prompt, entry ];
	padding: 16px;
}

prompt {
	enabled: false;
}

entry {
	placeholder: "search here";
	placeholder-color: @fg2;
	text-color: @fg0;
}

listview {
	columns: 1;
	lines: 4;
	layout: vertical;
	fixed-height: false;
}

element {
	orientation: horizontal;
	padding: 4px 16px;
	border-radius: 8px;
	text-color: @fg0;
}

element-icon {
	size: 28px;
}

element-text {
	text-color: inherit;
}

element selected {
	background-color: @accent;
	text-color: @fg1;
}
